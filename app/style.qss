QMainWindow, #root, #toolbarShell, #transportShell, #videoStage, #dockWorkspace {
    background: {{bg}};
    color: {{text}};
    font-size: 13px;
}
QLabel { background: transparent; }

QMenuBar {
    background: {{bg}};
    color: {{text_menu}};
    padding: 3px 20px;
    border-bottom: 1px solid {{border_bar}};
}
QMenuBar::item {
    padding: 5px 8px;
    border-radius: 4px;
}
QMenuBar::item:selected { background: {{hover}}; }
QMenu {
    background: {{menu}};
    color: {{text}};
    border: 1px solid {{border_menu}};
    border-radius: 6px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 30px 7px 12px;
    border-radius: 6px;
}
QMenu::item:selected { background: {{selected}}; }
QMenu::item:disabled { color: {{text_disabled}}; }

#toolBar {
    background: {{panel}};
    border-top: 1px solid {{line}};
    border-bottom: none;
}
#viewToolbar {
    background: {{panel_alt}};
    border-top: 1px solid {{line}};
    border-bottom: 1px solid {{border_input}};
}
#viewFieldLabel, #viewUnits {
    color: {{text_muted}};
    font-size: 11px;
}
#viewFieldEdit, #viewFieldRead, #viewTrackSelect {
    background: {{input}};
    color: {{text_body}};
    border: 1px solid {{border_input}};
    border-radius: 3px;
    padding: 2px 6px;
    min-height: 20px;
    font-size: 12px;
}
#viewFieldRead {
    background: {{input_read}};
    color: {{text_dim}};
}
#viewFieldEdit:focus {
    border-color: {{accent}};
}
#viewToolButton, #viewStepButton {
    background: {{button}};
    border: 1px solid {{border_btn}};
    border-radius: 3px;
    min-width: 26px;
    min-height: 22px;
    max-width: 28px;
    max-height: 24px;
    padding: 1px;
}
#viewToolButton:checked {
    background: {{checked_bg}};
    border-color: {{checked_border}};
}
#viewToolButton:hover, #viewStepButton:hover { background: {{button_hover}}; }
#dataColumn {
    background: {{panel}};
    border-left: 1px solid {{border}};
}
#dataTabs {
    background: {{panel}};
    border-top: 1px solid {{border}};
}
#dataTabs::pane {
    border: none;
}
#dataTabs QTabBar::tab {
    background: {{raised}};
    color: {{text_dim}};
    padding: 6px 12px;
    border: 1px solid {{border}};
    border-bottom: none;
}
#dataTabs QTabBar::tab:selected {
    background: {{panel}};
    color: {{text_bright}};
}
#trackChartView { background: {{panel}}; border: none; }
#chartQuantityRow { background: transparent; }
#chartQuantity, #chartVelocityMode {
    background: {{input}};
    color: {{text_body}};
    border: 1px solid {{border_input}};
    border-radius: 3px;
    padding: 1px 6px;
    min-height: 20px;
    max-width: 150px;
    font-size: 11px;
    selection-background-color: {{selection}};
}
#chartVelocityMode { max-width: 110px; }
#chartQuantity:hover, #chartVelocityMode:hover {
    background: {{hover_input}};
    border-color: {{border_loop}};
}
#chartQuantity::drop-down, #chartVelocityMode::drop-down {
    border: none;
    width: 16px;
}
#chartQuantity QAbstractItemView, #chartVelocityMode QAbstractItemView {
    background: {{menu}};
    color: {{text}};
    border: 1px solid {{border_popup}};
    selection-background-color: {{selection_menu}};
}
#chartStep, #chartFit {
    background: {{input}};
    color: {{text_body}};
    border: 1px solid {{border_input}};
    border-radius: 3px;
    padding: 1px 4px;
    min-height: 20px;
    font-size: 11px;
}
#chartStep { max-width: 64px; }
#chartFit { max-width: 96px; }
#chartFitLabel {
    color: {{text_secondary}};
    font-size: 11px;
}
#videoView, #videoStage { background: {{bg}}; border: none; }
#toolDivider { background: {{border_line}}; }
#toolBar QToolButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 5px;
    min-width: 29px;
    min-height: 29px;
}
#toolBar QToolButton:hover { background: {{hover_tool}}; }
#toolBar QToolButton:pressed { background: {{bg_pressed}}; }
#zoomReadout {
    color: {{text_secondary}};
    background: {{chip}};
    font-size: 11px;
    padding: 5px 10px;
    border: 1px solid {{border_btn}};
    border-radius: 6px;
}

#transportBar {
    background: {{panel}};
    border-top: 1px solid {{border_input}};
}

QPushButton#iconButton {
    background: {{button}};
    border: 1px solid {{border_btn}};
    border-radius: 3px;
    padding: 0;
    min-width: 32px;
    min-height: 24px;
    max-width: 32px;
    max-height: 24px;
}
QPushButton#iconButton:hover {
    background: {{button_hover}};
    border-color: {{border_hover}};
}
QPushButton#iconButton:pressed { background: {{button_pressed}}; }
QPushButton#iconButton:disabled {
    background: {{toast}};
    border-color: {{button_disabled_border}};
}

QPushButton#playButton {
    background: {{hover_tool}};
    border: 1px solid {{border_play}};
    border-radius: 3px;
    padding: 0;
    min-width: 32px;
    min-height: 24px;
    max-width: 32px;
    max-height: 24px;
}
QPushButton#playButton:hover { background: {{hover_strong}}; }
QPushButton#playButton:pressed { background: {{menu}}; }
QPushButton#playButton:disabled {
    background: {{button_disabled}};
    border-color: {{border_disabled}};
}

QSlider#timeline::groove:horizontal {
    height: 2px;
    background: {{groove}};
    border-radius: 1px;
}
QSlider#timeline { background: transparent; }
QSlider#timeline::sub-page:horizontal {
    background: {{groove_fill}};
    border-radius: 1px;
}
QSlider#timeline::add-page:horizontal {
    background: {{groove}};
    border-radius: 1px;
}
QSlider#timeline::handle:horizontal {
    width: 1px;
    height: 1px;
    margin: -1px 0;
    background: transparent;
    border: none;
}

#frameReadout {
    font-family: Menlo;
    font-size: 11px;
    min-width: 82px;
    color: {{text_dim}};
}

#videoInfoLabel {
    font-family: Menlo;
    font-size: 11px;
    color: {{text_faint}};
    background: transparent;
    border: none;
    padding: 0 10px;
}

#speedControl, #stepControl {
    background: {{input}};
    color: {{text_body}};
    border: 1px solid {{border_input}};
    border-radius: 3px;
    padding: 3px 8px;
    min-height: 20px;
    selection-background-color: {{selection}};
}
#speedControl:hover, #stepControl:hover {
    background: {{hover_input}};
    border-color: {{border_loop}};
}
#speedControl::drop-down {
    border: none;
    width: 18px;
}
#speedControl QAbstractItemView {
    background: {{menu}};
    color: {{text}};
    border: 1px solid {{border_popup}};
    selection-background-color: {{selection_menu}};
}
#stepControl::up-button, #stepControl::down-button {
    background: transparent;
    width: 16px;
    border: none;
}
#loopButton {
    background: {{menu}};
    border: 1px solid {{border_loop}};
    border-radius: 3px;
    padding: 2px;
    min-width: 26px;
    min-height: 24px;
    max-width: 26px;
    max-height: 24px;
}
#loopButton:hover {
    background: {{hover_soft}};
    border-color: {{loop_hover_border}};
}
#loopButton:pressed { background: {{bg_pressed_2}}; }
#loopButton:checked {
    background: {{loop_on}};
    border-color: {{text_strong}};
}
#loopButton:disabled {
    background: {{panel}};
    border-color: {{border}};
}

#stepStepper {
    background: {{raised}};
    border: 1px solid {{border_input}};
    border-radius: 3px;
}
#stepGlyph {
    background: transparent;
    border: none;
    padding: 0 4px;
    min-width: 22px;
    min-height: 22px;
}
#stepGlyph:hover { background: {{selected}}; }
#stepValue {
    background: transparent;
    color: {{text_soft}};
    border: none;
    font-size: 12px;
    min-width: 22px;
    padding-left: 6px;
}
#stepValue::drop-down {
    border: none;
    width: 0px;
}
#stepValue QAbstractItemView {
    background: {{menu}};
    color: {{text}};
    border: 1px solid {{border_popup}};
    selection-background-color: {{selection_list}};
    outline: none;
}

#trackListPanel, #trackDataPanel, #trackChartPanel, #trackManagerWindow, #dataColumn {
    background: {{panel}};
    border-left: 1px solid {{border}};
}
#trackDataPanel, #trackChartPanel { border-left: none; }
#panelTitle {
    color: {{text_soft}};
    font-size: 12px;
    font-weight: 600;
}
#panelHint { color: {{text_muted}}; font-size: 11px; }
#panelWarn { color: #f0c14b; font-size: 11px; }
#panelCheck {
    color: {{text_check}};
    spacing: 6px;
}
#panelCheck::indicator {
    width: 14px;
    height: 14px;
}
#panelButton, #panelButtonPrimary {
    background: {{button}};
    color: {{text}};
    border: 1px solid {{border_line}};
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
}
#panelButtonPrimary { background: {{checked_bg}}; border-color: {{checked_border}}; }
#panelButton:hover, #panelButtonPrimary:hover { background: {{button_hover}}; }
#trackList {
    background: {{sunken}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 4px;
}
#trackTable {
    background: {{sunken}};
    color: {{text}};
    gridline-color: {{line}};
    border: 1px solid {{border}};
}
#trackTable QHeaderView::section {
    background: {{raised}};
    color: {{text_dim}};
    border: none;
    padding: 4px;
}
QTableCornerButton::section {
    background: {{raised}};
    border: none;
}
QScrollBar:horizontal, QScrollBar:vertical {
    background: {{sunken}};
    border: none;
    margin: 0;
}
QScrollBar:horizontal { height: 12px; }
QScrollBar:vertical { width: 12px; }
QScrollBar::handle:horizontal, QScrollBar::handle:vertical {
    background: {{border_hover}};
    border-radius: 4px;
    min-width: 24px;
    min-height: 24px;
}
QScrollBar::handle:horizontal:hover, QScrollBar::handle:vertical:hover {
    background: {{text_faint}};
}
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: {{sunken}};
    border: none;
    width: 0;
    height: 0;
}
#trackProgress {
    background: {{sunken}};
    border: 1px solid {{border}};
    min-height: 10px;
    max-height: 10px;
}
#trackProgress::chunk { background: {{accent}}; }

#downloadToast {
    background: {{toast}};
    color: {{text_toast}};
    border: 1px solid {{toast_border}};
    border-radius: 6px;
}
#downloadToastTitle {
    color: {{text_strong}};
    font-size: 13px;
    font-weight: 600;
}
#downloadToastDetail {
    color: {{text_toast_dim}};
    font-size: 11px;
}
#downloadToastStatus {
    color: {{text_check}};
    font-size: 11px;
}
#downloadToastBar {
    background: {{sunken}};
    border: 1px solid {{border}};
    min-height: 8px;
    max-height: 8px;
    border-radius: 2px;
}
#downloadToastBar::chunk {
    background: #0078d4;
    border-radius: 2px;
}
#downloadToastCancel {
    background: transparent;
    color: {{text_check}};
    border: 1px solid {{border_line}};
    border-radius: 4px;
    padding: 2px 10px;
    min-height: 22px;
    font-size: 11px;
}
#downloadToastCancel:hover { background: {{selected}}; color: {{text_strong}}; }
#downloadToastCancel:disabled { color: {{text_disabled_2}}; border-color: {{border}}; }

#tutorialOverlay {
    background: transparent;
}
#tutorialCard {
    background: {{toast}};
    color: {{text_toast}};
    border: 1px solid {{toast_border}};
    border-radius: 8px;
}
#tutorialTitle {
    color: {{text_strong}};
    font-size: 14px;
    font-weight: 600;
}
#tutorialBody {
    color: {{text_check}};
    font-size: 12px;
}
#tutorialCounter {
    color: {{text_muted}};
    font-size: 11px;
}
#tutorialSkip, #tutorialBack, #tutorialNext {
    background: transparent;
    color: {{text_check}};
    border: 1px solid {{border_line}};
    border-radius: 4px;
    padding: 4px 12px;
    min-height: 24px;
    font-size: 12px;
}
#tutorialSkip:hover, #tutorialBack:hover, #tutorialNext:hover { background: {{selected}}; color: {{text_strong}}; }
#tutorialNext {
    background: #2d4a66;
    border-color: {{accent_bright}};
    color: {{text_strong}};
}
#tutorialNext:hover { background: #35567a; color: #ffffff; }
#tutorialStage {
    background: {{bg_stage}};
    border: 1px solid {{border}};
    border-radius: 6px;
}

#chartScrubReadout {
    background: {{raised}};
    color: {{text_readout}};
    border: 1px solid {{border_line}};
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 11px;
}

QSplitter::handle { background: {{line}}; }
QStatusBar {
    background: {{bg_status}};
    border-top: 1px solid {{button_border}};
    color: {{text_muted}};
    font-size: 11px;
}
QStatusBar::item { border: none; }

QDockWidget {
    color: {{text}};
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title {
    background: {{raised}};
    color: {{text_soft}};
    padding: 5px 8px;
    border-bottom: 1px solid {{border}};
    text-align: left;
}
QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    padding: 0px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: {{button_hover}};
    border-radius: 3px;
}

#calibrationDialog {
    background: {{panel}};
    color: {{text_cal}};
}
#calibrationDialog QLabel,
#calibrationDialog QRadioButton,
#calibrationDialog QCheckBox {
    color: {{text_cal}};
    background: transparent;
}
#calibrationDialog QRadioButton::indicator,
#calibrationDialog QCheckBox::indicator {
    background: {{input}};
    border: 1px solid {{border_indicator}};
    width: 13px;
    height: 13px;
    border-radius: 7px;
}
#calibrationDialog QCheckBox::indicator {
    border-radius: 3px;
}
#calibrationDialog QRadioButton::indicator:checked,
#calibrationDialog QCheckBox::indicator:checked {
    background: {{teal}};
    border-color: {{teal}};
}
#calibrationDialog #panelHint {
    color: {{text_toast}};
}
#calLengthSpin {
    background: {{input}};
    color: {{text_body}};
    border: 1px solid {{border_input}};
    border-radius: 3px;
    padding: 3px 6px;
    min-height: 22px;
}
#assistantWindow, #assistantPanel, #assistantChatColumn, #assistantContext, #assistantChatHost {
    background: {{assistant_bg}};
    color: {{assistant_text}};
}
#assistantHeaderWrap {
    background: {{assistant_bg}};
}
#assistantHeader {
    background: {{assistant_bg}};
    border-bottom: 1px solid {{assistant_line}};
}
#assistantNotice {
    color: {{assistant_link}};
    font-size: 12px;
    padding: 0 16px 10px 16px;
    background: {{assistant_bg}};
}
#assistantChip {
    background: transparent;
    color: {{assistant_muted}};
    border: 1px solid {{assistant_border_2}};
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 12px;
}
#assistantChip[tone="ok"] { color: {{chip_ok}}; border-color: {{chip_ok_border}}; }
#assistantChip[tone="warn"] { color: {{chip_warn}}; border-color: {{chip_warn_border}}; }
#assistantChip[tone="bad"] { color: {{chip_bad}}; border-color: {{chip_bad_border}}; }
#assistantChatTitle {
    background: {{assistant_bg}};
    border-bottom: 1px solid {{assistant_line}};
}
#assistantChatHeading {
    color: {{assistant_text}};
    font-size: 14px;
    font-weight: 600;
}
#assistantContextScroll {
    background: {{assistant_sunken}};
    border-right: 1px solid {{assistant_line}};
}
#assistantReady, #assistantStale, #assistantCal, #assistantHint {
    color: {{assistant_muted}};
    font-size: 12px;
}
#assistantStale { color: {{chip_warn}}; }
#assistantCard {
    background: {{assistant_card}};
    color: {{assistant_text}};
    border: 1px solid {{assistant_border}};
    border-radius: 10px;
    margin-top: 6px;
    padding-top: 10px;
}
#assistantCard::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: {{assistant_link}};
}
#assistantCandidates, #assistantMeasures, #assistantReport {
    background: {{assistant_bg}};
    color: {{assistant_text}};
    border: 1px solid {{assistant_border}};
    border-radius: 8px;
    padding: 8px;
    selection-background-color: {{assistant_selection}};
    selection-color: {{assistant_text}};
}
#assistantChat {
    background: {{assistant_bg}};
    border: none;
    padding: 0;
}
#assistantChatHost {
    background: {{assistant_bg}};
}
#assistantMessage {
    background: transparent;
}
#assistantRole {
    color: {{assistant_faint}};
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
}
#assistantThinking {
    background: transparent;
}
#assistantThinkingToggle {
    background: transparent;
    border: none;
    color: {{assistant_faint}};
    font-size: 13px;
    font-weight: 500;
    padding: 0;
}
#assistantThinkingToggle:hover { color: {{assistant_link}}; }
#assistantThinkingToggle:checked { color: {{assistant_link_2}}; }
#assistantThinkingBody {
    background: transparent;
    color: {{assistant_think}};
    border: none;
    border-left: 1px solid {{assistant_border_2}};
    padding: 0 0 0 10px;
    font-size: 13px;
    selection-background-color: {{assistant_selection}};
    selection-color: {{assistant_link}};
}
#assistantMessageBody {
    background: transparent;
    color: {{assistant_text}};
    border: none;
    padding: 0;
    font-size: 15px;
    selection-background-color: {{assistant_selection}};
    selection-color: {{assistant_text}};
}
#assistantComposer {
    background: {{assistant_bg}};
    border-top: 1px solid {{assistant_line}};
}
#assistantInput {
    background: {{assistant_input}};
    color: {{assistant_text}};
    border: 1px solid {{assistant_border_2}};
    border-radius: 14px;
    padding: 10px 12px;
    min-height: 72px;
}
#assistantInput:focus { border-color: {{assistant_focus}}; }
#assistantPanel QPushButton {
    background: {{assistant_button}};
    color: {{assistant_text}};
    border: 1px solid {{assistant_border_2}};
    border-radius: 8px;
    padding: 5px 12px;
    min-height: 28px;
}
#assistantPanel QPushButton:hover { background: {{assistant_hover}}; }
#assistantPanel QPushButton:disabled { color: {{assistant_disabled}}; }
#assistantPrimaryButton {
    background: {{assistant_button}};
    color: {{assistant_text}};
    border: 1px solid {{assistant_focus}};
    font-weight: 600;
}
#assistantPrimaryButton:hover { background: {{assistant_primary_hover}}; }
#assistantPrimaryButton:disabled {
    background: {{assistant_button}};
    color: {{assistant_disabled}};
    border-color: {{assistant_border_2}};
}
#assistantLevel, #assistantPanel QComboBox, #assistantPanel QDoubleSpinBox, #assistantPanel QLineEdit {
    background: {{assistant_input}};
    color: {{assistant_text}};
    border: 1px solid {{assistant_border_2}};
    border-radius: 6px;
    padding: 3px 8px;
    min-height: 24px;
}
#assistantSplitter::handle {
    background: {{assistant_line}};
    width: 6px;
}

#helpDialog { background: {{bg}}; color: {{text}}; }
#helpScroll, #helpBody { background: transparent; }
#helpLead {
    color: {{text_muted}};
    font-size: 13px;
}
#helpHeading {
    color: {{text_strong}};
    font-size: 15px;
    font-weight: 600;
}
#helpCopy {
    color: {{text}};
    font-size: 13px;
}
#helpClose { min-width: 72px; }
